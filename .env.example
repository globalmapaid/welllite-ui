# Base URL of the welllite-api backend (include the /api/v1 prefix).
# Local dev default — the backend's CORS allows http://localhost:3000 out of the box.
VITE_API_BASE_URL=http://localhost:8001/api/v1

# --- Map basemaps (all optional) ---
# The wells map defaults to keyless tiles, so no map vendor account is needed.
# Set these to move to a commercial provider (Mapbox, MapTiler, …); the
# attribution vars exist because most paid providers require their own credit.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# VITE_MAP_SATELLITE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_MAP_SATELLITE_ATTRIBUTION=Imagery &copy; Esri, Maxar, Earthstar Geographics
